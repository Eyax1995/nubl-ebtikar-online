# رؤوس أمان عامة (لا تؤثر على التضمين داخل الموقع نفسه)
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# مناطق خاصة لا تُفهرس (البوابات وروابط المتابعة الموقّعة ومساعد واتساب)
/marketing/rep/*
  X-Robots-Tag: noindex, nofollow
/marketing/client/*
  X-Robots-Tag: noindex, nofollow
/marketing/portal/*
  X-Robots-Tag: noindex, nofollow
/marketing/track/*
  X-Robots-Tag: noindex, nofollow
/marketing/careers/interview/*
  X-Robots-Tag: noindex, nofollow
/wa/*
  X-Robots-Tag: noindex, nofollow
/mirror/*
  X-Robots-Tag: noindex, nofollow

# ملفات البحث بالذكاء الاصطناعي ومحركات البحث
/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=3600
/marketing/pricing.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=3600
/marketing/sitemap.xml
  Cache-Control: public, max-age=3600
/marketing/analytics.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/nd/*
  Cache-Control: public, max-age=86400
/catalog/*
  Cache-Control: public, max-age=86400
/marketing/hub/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-cache

# أصول موقع التسويق (غير مُجزّأة بالهاش → يوم للـCSS/JS، 30 يوماً للصور والخطوط والمجسم)
/marketing/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/marketing/site.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/marketing/app.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/marketing/fx.bundle.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
/marketing/model.glb
  Cache-Control: public, max-age=2592000
/marketing/*.webp
  Cache-Control: public, max-age=2592000
/marketing/*.jpg
  Cache-Control: public, max-age=2592000
/marketing/*.png
  Cache-Control: public, max-age=2592000
/marketing/pattern.svg
  Cache-Control: public, max-age=2592000
/designs/*
  Cache-Control: public, max-age=2592000

# ملفات المنصة الداخلية مُرقّمة بـ ?v= في index.html → تُخزَّن طويلاً (index.html نفسه no-cache أعلاه)
/marketing/hub/*.js
  Cache-Control: public, max-age=31536000, immutable
/marketing/hub/*.css
  Cache-Control: public, max-age=31536000, immutable
